# Reference only: enter your values in Hugging Face Space settings.
# Do not upload a filled copy. The app does not load .env files.
OPENCLAW_GATEWAY_TOKEN=replace-with-a-long-random-token
TELEGRAM_API_ID=YOUR_NUMERIC_API_ID
TELEGRAM_API_HASH=YOUR_API_HASH
TELEGRAM_BOT_TOKEN=YOUR_BOTFATHER_TOKEN

# Optional public variable: numeric user IDs, not group IDs.
# TELEGRAM_ALLOW_FROM=123456789,987654321

# Optional private secrets, only for intentional API-key authentication.
# OPENAI_API_KEY=YOUR_OWN_KEY
# ANTHROPIC_API_KEY=YOUR_OWN_KEY

# Required private bucket mount, read-write: /data/openclaw-backups
# No HF_TOKEN is needed at runtime for this attached volume.
